# My Finance Manager - Backend environment variables
# Copy to `.env` for local development. Never commit real values.

# ---- Server ----
PORT=8080
SPRING_PROFILES_ACTIVE=dev

# ---- Database (PostgreSQL) ----
# Either provide a full platform-style URL...
DATABASE_URL=postgresql://myfinance:myfinance@localhost:5432/myfinance
# ...or the individual Spring properties (used when DATABASE_URL is absent).
# SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/myfinance
# SPRING_DATASOURCE_USERNAME=myfinance
# SPRING_DATASOURCE_PASSWORD=myfinance
# Optional SSL mode appended to the JDBC URL (e.g. `require` for Neon).
# DATABASE_SSL_MODE=require
DB_POOL_SIZE=10

# ---- JWT ----
# Must be at least 32 bytes. Generate with: openssl rand -base64 48
JWT_SECRET=change-me-to-a-random-secret-of-at-least-32-bytes
JWT_ISSUER=my-finance-manager
JWT_ACCESS_TTL=PT15M
JWT_REFRESH_TTL=P30D

# ---- Google Sign-In (optional) ----
GOOGLE_CLIENT_ID=

# ---- OpenRouter (AI insights + statement-parsing fallback) ----
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Model is configurable so it can be changed without a redeploy.
OPENROUTER_MODEL=openai/gpt-4o-mini

# ---- Rapid Bank Statement Parsing API (primary statement parser, optional) ----
RAPIDAPI_KEY=
RAPIDAPI_HOST=
RAPIDAPI_URL=
RAPIDAPI_FILE_FIELD_NAME=file

# ---- Storage & CORS ----
STORAGE_LOCATION=./data/uploads
CORS_ALLOWED_ORIGINS=*
