# My Finance Manager - Backend environment variables
# Copy to `.env` for local development. Never commit real values.

# ---- Server ----
PORT=8080
SPRING_PROFILES_ACTIVE=dev

# ---- Database (PostgreSQL) ----
# Either provide a full platform-style URL...
DATABASE_URL=postgresql://myfinance:myfinance@localhost:5432/myfinance
# ...or the individual Spring properties (used when DATABASE_URL is absent).
# SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/myfinance
# SPRING_DATASOURCE_USERNAME=myfinance
# SPRING_DATASOURCE_PASSWORD=myfinance
# Optional SSL mode appended to the JDBC URL (e.g. `require` for Neon).
# DATABASE_SSL_MODE=require
DB_POOL_SIZE=10

# ---- Neon Auth (Managed Better Auth) ----
# The service that owns user credentials; this backend only verifies the JWTs it issues.
# Find it in the Neon Console under your branch's Auth tab. Note the database segment: the
# neon_auth schema lives in whichever database Auth was enabled on.
#
#   https://<endpoint>.neonauth.<region>.aws.neon.tech/<database>/auth
#
# Required. The issuer/audience (the origin, without the /<database>/auth path) and the JWKS
# URL are derived from it automatically; they and NEON_AUTH_JWKS_URI only need setting when the
# service is reached through a different hostname than the one its tokens name.
NEON_AUTH_URL=
# NEON_AUTH_ISSUER=
# NEON_AUTH_JWKS_URI=

# ---- OpenRouter (AI insights + statement-parsing fallback) ----
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Model is configurable so it can be changed without a redeploy.
OPENROUTER_MODEL=openai/gpt-4o-mini

# ---- Storage & CORS ----
STORAGE_LOCATION=./data/uploads
CORS_ALLOWED_ORIGINS=*
